+/*
+ * RustDesk: scene-change QP ladder.
+ *
+ * A full-screen change (window switch) makes VideoToolbox emit one P-frame of 1-1.5 MB at 4K,
+ * which takes 100+ ms on a 100 Mbit/s path before the client can show anything. Instead, when
+ * most of the sampled luma changes, encode that frame at a coarse base QP and the next frames
+ * at decreasing QPs, so a soft picture arrives quickly and sharpens over a few frames. The
+ * encoder's own rate control resumes afterwards. If the next frame is also a large change
+ * (scrolling, video), the ladder stops and rate control takes over until things calm down.
+ *
+ * RUSTDESK_VT_SCENE_LADDER: comma-separated QPs, e.g. "46,40,34,30"; unset or "0" = off.
+ * Off by default: low-latency rate control also drops frames to meet its bitrate (RustDesk
+ * treats three empty encodes in a row as a failed encoder) and adds ~45 ms per 4K frame.
+ * RUSTDESK_VT_SCENE_THRESHOLD: percent of sampled points that must change, default 30.
+ *
+ * The encoder fails one frame per session in this mode; see vtenc_output_callback().
+ *
+ * Separately, VideoToolbox returns packets asynchronously and FFmpeg only collects them on a
+ * later call, so a packet normally leaves about two frames after its input, and the last frames
+ * before a static screen wait for the next input. RUSTDESK_VT_SYNC (default on, "0" disables)
+ * completes each frame before returning so its packet is available immediately.
+ */
+static void vtenc_scene_parse_env(AVCodecContext *avctx)
+{
+    VTEncContext *vtctx = avctx->priv_data;
+    const char *ladder = getenv("RUSTDESK_VT_SCENE_LADDER");
+    const char *threshold = getenv("RUSTDESK_VT_SCENE_THRESHOLD");
+    char *end;
+
+    vtctx->scene_ladder_len = 0;
+    vtctx->scene_step = -1;
+    vtctx->scene_prev_big = 0;
+    vtctx->scene_have_samples = 0;
+    vtctx->scene_threshold = threshold ? atoi(threshold) : 30;
+    vtctx->sync_output = (avctx->codec_id == AV_CODEC_ID_H264 || avctx->codec_id == AV_CODEC_ID_HEVC) &&
+                         !(getenv("RUSTDESK_VT_SYNC") && !strcmp(getenv("RUSTDESK_VT_SYNC"), "0"));
+    if (vtctx->scene_threshold <= 0 || vtctx->scene_threshold > 100)
+        vtctx->scene_threshold = 30;
+    if (avctx->codec_id != AV_CODEC_ID_H264 && avctx->codec_id != AV_CODEC_ID_HEVC)
+        return;
+    if (!ladder)
+        return;
+    while (*ladder && vtctx->scene_ladder_len < FF_ARRAY_ELEMS(vtctx->scene_ladder)) {
+        long qp = strtol(ladder, &end, 10);
+        if (end == ladder)
+            break;
+        if (qp <= 0 || qp > 51) {
+            vtctx->scene_ladder_len = 0;
+            return;
+        }
+        vtctx->scene_ladder[vtctx->scene_ladder_len++] = (int)qp;
+        ladder = *end == ',' ? end + 1 : end;
+    }
 }
 
+/* Returns the base QP to force for this frame, or 0 to leave it to rate control. */
+static int vtenc_scene_qp(AVCodecContext *avctx, VTEncContext *vtctx, const AVFrame *frame)
+{
+    int changed = 0, big, qp = 0;
+
+    if (vtctx->scene_ladder_len <= 0 || !frame->data[0] || frame->linesize[0] <= 0 ||
+        avctx->width < SCENE_GRID_W || avctx->height < SCENE_GRID_H)
+        return 0;
+    for (int gy = 0; gy < SCENE_GRID_H; gy++) {
+        const uint8_t *row = frame->data[0] +
+            (size_t)((2 * gy + 1) * avctx->height / (2 * SCENE_GRID_H)) * frame->linesize[0];
+        for (int gx = 0; gx < SCENE_GRID_W; gx++) {
+            uint8_t *prev = &vtctx->scene_samples[gy * SCENE_GRID_W + gx];
+            uint8_t y = row[(2 * gx + 1) * avctx->width / (2 * SCENE_GRID_W)];
+            if (abs((int)y - (int)*prev) > 16)
+                changed++;
+            *prev = y;
+        }
+    }
+    big = vtctx->scene_have_samples &&
+          changed * 100 >= vtctx->scene_threshold * SCENE_GRID_W * SCENE_GRID_H;
+    vtctx->scene_have_samples = 1;
+
+    if (big && vtctx->scene_step > 0) {
+        vtctx->scene_step = -1;           /* still changing: hand back to rate control */
+    } else if (big && !vtctx->scene_prev_big) {
+        vtctx->scene_step = 0;
+    }
+    vtctx->scene_prev_big = big;
+    if (vtctx->scene_step >= 0) {
+        qp = vtctx->scene_ladder[vtctx->scene_step++];
+        if (vtctx->scene_step >= vtctx->scene_ladder_len)
+            vtctx->scene_step = -1;
+    }
+    return qp;
+}
